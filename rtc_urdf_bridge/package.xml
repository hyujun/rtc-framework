<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rtc_urdf_bridge</name>
  <version>5.17.0</version>
  <description>Robot-agnostic URDF parser and Pinocchio model builder for RT control loops. Supports full/reduced/tree models, closed-chain constraints, and RT-safe model handles (noexcept, zero-heap).</description>
  <maintainer email="jeryblueput@gmail.com">Junho Park</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>eigen</depend>
  <depend>pinocchio</depend>
  <depend>yaml-cpp</depend>
  <depend>tinyxml2</depend>

  <exec_depend>xacro</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <!-- 실모델 관성 게이트 테스트 전용. ARCH-5 준수 — build-time 의존이 아니라
       ament share dir 런타임 lookup 이다 (rtc_controller_manager 선례와 동일). -->
  <test_depend>ament_index_cpp</test_depend>
  <test_depend>robot_descriptions</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
