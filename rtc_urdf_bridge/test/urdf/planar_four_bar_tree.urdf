<?xml version="1.0"?>
<!-- planar_four_bar_tree.urdf — 순수 평면 4-bar (모든 관절 z축). sidecar 는
     planar_four_bar_tree.closure.yaml (contact_3d, c1 ≡ c2).

     Tree 구조 (두 branch 가 base 에서 갈라져 각 tip 에 closure frame 을 둠):
       base ─(j_crank : rev z)─▶ crank ─(j_coupler : rev z)─▶ coupler ─(c1_mount: fixed)─▶ c1
       base ─(j_rocker : rev z)─▶ rocker ─(c2_mount: fixed)─▶ c2

     [용도] 평면 loop 에 contact_3d 를 걸면 축방향(z) translation 행이 자세와 무관하게
     항등 0 이다 — **구속 중복** (행 rank 2 < rows 3) 이지만 passive 열 Jc_D (j_coupler,
     j_rocker) 는 full column rank 라 **조립 특이가 아니다**. 두 판정을 가르는 회귀 fixture
     (four_bar_tree 는 q_ref 에서 둘이 동시에 성립해 가르지 못한다).

     기하: ground 0.4 (x), crank 0.1 (+y), rocker 0.15 (+y), coupler √(0.4² + 0.05²).
     평행사변형이 아니라 (crank ≠ rocker) 일직선·대칭 특이 자세를 피한다. neutral(q=0) 에서
     c1 world = c2 world = (0.4, 0.15, 0) → 조립 상태 (j_coupler 의 origin rpy 가 coupler 를
     c2 로 겨눈다). -->
<robot name="planar_four_bar_tree">

  <link name="base">
    <inertial>
      <mass value="10.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/>
    </inertial>
  </link>

  <link name="crank">
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0.05 0"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
  </link>

  <link name="coupler">
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0.2 0 0"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
  </link>

  <link name="rocker">
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0.075 0"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
  </link>

  <!-- closure frame link (질량 미소 — 순수 frame 용도) -->
  <link name="c1">
    <inertial>
      <mass value="1e-4"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1e-8" ixy="0" ixz="0" iyy="1e-8" iyz="0" izz="1e-8"/>
    </inertial>
  </link>

  <link name="c2">
    <inertial>
      <mass value="1e-4"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1e-8" ixy="0" ixz="0" iyy="1e-8" iyz="0" izz="1e-8"/>
    </inertial>
  </link>

  <!-- ── Branch 1: base → crank → coupler → c1 ─────────────────────────────── -->
  <joint name="j_crank" type="revolute">
    <parent link="base"/><child link="crank"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3" upper="3" effort="1" velocity="1"/>
  </joint>

  <joint name="j_coupler" type="revolute">
    <parent link="crank"/><child link="coupler"/>
    <!-- yaw = atan2(0.05, 0.4) → coupler x축이 (0,0.1) 에서 (0.4,0.15) 를 향한다 -->
    <origin xyz="0 0.1 0" rpy="0 0 0.124354994547"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3" upper="3" effort="1" velocity="1"/>
  </joint>

  <joint name="c1_mount" type="fixed">
    <parent link="coupler"/><child link="c1"/>
    <!-- coupler 길이 √(0.4² + 0.05²) -->
    <origin xyz="0.403112887415 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ── Branch 2: base → rocker → c2 ──────────────────────────────────────── -->
  <joint name="j_rocker" type="revolute">
    <parent link="base"/><child link="rocker"/>
    <origin xyz="0.4 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3" upper="3" effort="1" velocity="1"/>
  </joint>

  <joint name="c2_mount" type="fixed">
    <parent link="rocker"/><child link="c2"/>
    <origin xyz="0 0.15 0" rpy="0 0 0"/>
  </joint>

</robot>
