<?xml version="1.0"?>
<!-- trunk_two_hands.urdf — a body that is a kinematic TREE with a hand mounted
     on EACH of its two branches (test fixture, synthetic).

       world ─(fixed)─ pelvis ─ waist_yaw ─ torso ─┬─ left_shoulder ─ left_elbow ─ left_forearm
                                                   │     left_forearm ─(fixed, left_mount)─ left_palm
                                                   │     left_palm ─┬─ left_finger_a ─ left_tip_a
                                                   │                ├─ left_finger_b ─ left_tip_b
                                                   │                └─ left_finger_c ─ left_tip_c
                                                   └─ right_shoulder ─ right_elbow ─ right_forearm
                                                         right_forearm ─(fixed, right_mount)─ right_palm
                                                         right_palm ─┬─ right_finger_a ─ right_tip_a
                                                                     ├─ right_finger_b ─ right_tip_b
                                                                     └─ right_finger_c ─ right_tip_c

     11 revolute joints: body 5 (waist 1 + two arms of 2), hands 3 + 3 (serial
     fingers, no loop closure). It is the smallest shape that has what a
     humanoid with two hands has as THREE device groups: a body tree with two
     branches, and a hand tree hanging off each branch (#715).

     The asymmetries below are load-bearing for the three-group tests
     (integrated_bringup/test/test_joint_three_groups.cpp): the two hands have
     different finger lengths, origins and axes, so a command or a pose that
     was meant for one hand and landed on the other moves a different tip to a
     different place. Both mounts are non-identity, and the two arms differ as
     in dual_arm_tree_hand.urdf. pinocchio orders the joints waist, left arm,
     left fingers, right arm, right fingers.
-->
<robot name="trunk_two_hands">

  <link name="world"/>
  <joint name="world_to_pelvis" type="fixed">
    <parent link="world"/><child link="pelvis"/>
    <origin xyz="0.10 -0.20 0.80" rpy="0.10 -0.20 0.30"/>
  </joint>

  <!-- ── Body ─────────────────────────────────────────────────────────── -->
  <link name="pelvis">
    <inertial><mass value="5.0"/><origin xyz="0 0 0.02"/><inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/></inertial>
  </link>
  <link name="torso">
    <inertial><mass value="8.0"/><origin xyz="0 0 0.15"/><inertia ixx="0.08" ixy="0" ixz="0" iyy="0.07" iyz="0" izz="0.05"/></inertial>
  </link>
  <joint name="waist_yaw" type="revolute">
    <parent link="pelvis"/><child link="torso"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.0" upper="2.0" effort="80" velocity="10"/>
  </joint>

  <!-- left arm: both axes y, upper link 0.22 -->
  <link name="left_upper">
    <inertial><mass value="1.2"/><origin xyz="0 0 -0.10"/><inertia ixx="0.006" ixy="0" ixz="0" iyy="0.006" iyz="0" izz="0.002"/></inertial>
  </link>
  <link name="left_forearm">
    <inertial><mass value="0.8"/><origin xyz="0 0 -0.09"/><inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.001"/></inertial>
  </link>
  <joint name="left_shoulder" type="revolute">
    <parent link="torso"/><child link="left_upper"/>
    <origin xyz="0.02 0.18 0.25" rpy="0.30 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.5" upper="2.5" effort="25" velocity="10"/>
  </joint>
  <joint name="left_elbow" type="revolute">
    <parent link="left_upper"/><child link="left_forearm"/>
    <origin xyz="0.03 0.02 -0.22" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="25" velocity="10"/>
  </joint>

  <!-- right arm: shoulder axis y, elbow axis x, upper link 0.27 -->
  <link name="right_upper">
    <inertial><mass value="1.3"/><origin xyz="0 0 -0.12"/><inertia ixx="0.007" ixy="0" ixz="0" iyy="0.007" iyz="0" izz="0.002"/></inertial>
  </link>
  <link name="right_forearm">
    <inertial><mass value="0.9"/><origin xyz="0 0 -0.10"/><inertia ixx="0.004" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.001"/></inertial>
  </link>
  <joint name="right_shoulder" type="revolute">
    <parent link="torso"/><child link="right_upper"/>
    <origin xyz="0.01 -0.20 0.24" rpy="-0.20 0.10 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.5" upper="2.5" effort="25" velocity="10"/>
  </joint>
  <joint name="right_elbow" type="revolute">
    <parent link="right_upper"/><child link="right_forearm"/>
    <origin xyz="0.05 -0.01 -0.27" rpy="0 0 0.40"/>
    <axis xyz="1 0 0"/>
    <limit lower="-2.0" upper="2.0" effort="25" velocity="10"/>
  </joint>

  <!-- ── Left hand mount + fingers ────────────────────────────────────── -->
  <link name="left_palm">
    <inertial><mass value="0.3"/><origin xyz="0 0 0.02"/><inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003"/></inertial>
  </link>
  <joint name="left_mount" type="fixed">
    <parent link="left_forearm"/><child link="left_palm"/>
    <origin xyz="0.01 0.004 -0.20" rpy="-1.5708 0 0.7854"/>
  </joint>

  <link name="left_a_link">
    <inertial><mass value="0.03"/><origin xyz="0 0 0.02"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial>
  </link>
  <link name="left_tip_a">
    <inertial><mass value="0.01"/><origin xyz="0 0 0"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
  </link>
  <joint name="left_finger_a" type="revolute">
    <parent link="left_palm"/><child link="left_a_link"/>
    <origin xyz="-0.02 0.03 0.05" rpy="0 0.50 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.0" upper="1.5" effort="3" velocity="5"/>
  </joint>
  <joint name="left_tip_a_fixed" type="fixed">
    <parent link="left_a_link"/><child link="left_tip_a"/>
    <origin xyz="0.004 0 0.040" rpy="0 0 0"/>
  </joint>

  <link name="left_b_link">
    <inertial><mass value="0.03"/><origin xyz="0 0 0.02"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial>
  </link>
  <link name="left_tip_b">
    <inertial><mass value="0.01"/><origin xyz="0 0 0"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
  </link>
  <joint name="left_finger_b" type="revolute">
    <parent link="left_palm"/><child link="left_b_link"/>
    <origin xyz="0.03 0.01 0.07" rpy="0.20 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5" upper="1.5" effort="3" velocity="5"/>
  </joint>
  <joint name="left_tip_b_fixed" type="fixed">
    <parent link="left_b_link"/><child link="left_tip_b"/>
    <origin xyz="0 0.002 0.050" rpy="0 0 0"/>
  </joint>

  <link name="left_c_link">
    <inertial><mass value="0.03"/><origin xyz="0 0 0.02"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial>
  </link>
  <link name="left_tip_c">
    <inertial><mass value="0.01"/><origin xyz="0 0 0"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
  </link>
  <joint name="left_finger_c" type="revolute">
    <parent link="left_palm"/><child link="left_c_link"/>
    <origin xyz="0.03 -0.03 0.06" rpy="-0.20 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.5" upper="1.5" effort="3" velocity="5"/>
  </joint>
  <joint name="left_tip_c_fixed" type="fixed">
    <parent link="left_c_link"/><child link="left_tip_c"/>
    <origin xyz="0 -0.003 0.045" rpy="0 0 0"/>
  </joint>

  <!-- ── Right hand mount + fingers (other lengths, origins, axes) ─────── -->
  <link name="right_palm">
    <inertial><mass value="0.3"/><origin xyz="0 0 0.02"/><inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003"/></inertial>
  </link>
  <joint name="right_mount" type="fixed">
    <parent link="right_forearm"/><child link="right_palm"/>
    <origin xyz="0.0415 -0.003 -0.21" rpy="1.5708 0 1.5708"/>
  </joint>

  <link name="right_a_link">
    <inertial><mass value="0.03"/><origin xyz="0 0 0.02"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial>
  </link>
  <link name="right_tip_a">
    <inertial><mass value="0.01"/><origin xyz="0 0 0"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
  </link>
  <joint name="right_finger_a" type="revolute">
    <parent link="right_palm"/><child link="right_a_link"/>
    <origin xyz="-0.025 0.02 0.055" rpy="0 -0.40 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5" upper="1.5" effort="3" velocity="5"/>
  </joint>
  <joint name="right_tip_a_fixed" type="fixed">
    <parent link="right_a_link"/><child link="right_tip_a"/>
    <origin xyz="0 0.003 0.050" rpy="0 0 0"/>
  </joint>

  <link name="right_b_link">
    <inertial><mass value="0.03"/><origin xyz="0 0 0.02"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial>
  </link>
  <link name="right_tip_b">
    <inertial><mass value="0.01"/><origin xyz="0 0 0"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
  </link>
  <joint name="right_finger_b" type="revolute">
    <parent link="right_palm"/><child link="right_b_link"/>
    <origin xyz="0.02 0.015 0.075" rpy="0.10 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5" upper="1.5" effort="3" velocity="5"/>
  </joint>
  <joint name="right_tip_b_fixed" type="fixed">
    <parent link="right_b_link"/><child link="right_tip_b"/>
    <origin xyz="0.002 0 0.060" rpy="0 0 0"/>
  </joint>

  <link name="right_c_link">
    <inertial><mass value="0.03"/><origin xyz="0 0 0.02"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial>
  </link>
  <link name="right_tip_c">
    <inertial><mass value="0.01"/><origin xyz="0 0 0"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
  </link>
  <joint name="right_finger_c" type="revolute">
    <parent link="right_palm"/><child link="right_c_link"/>
    <origin xyz="0.035 -0.025 0.065" rpy="-0.30 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5" upper="1.5" effort="3" velocity="5"/>
  </joint>
  <joint name="right_tip_c_fixed" type="fixed">
    <parent link="right_c_link"/><child link="right_tip_c"/>
    <origin xyz="0 -0.002 0.035" rpy="0 0 0"/>
  </joint>

</robot>
