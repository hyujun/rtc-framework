<?xml version="1.0"?>
<!-- dual_arm_tree_hand.urdf — a body that is a kinematic TREE, with a hand
     mounted on one of its two branches (test fixture, synthetic).

       world ─(fixed)─ pelvis ─ waist_yaw ─ torso ─┬─ left_shoulder ─ left_elbow ─ left_tip
                                                   └─ right_shoulder ─ right_elbow ─ right_wrist
                                                        right_wrist ─(fixed, hand_mount)─ hand_base
                                                        hand_base ─┬─ finger_a_1 ─ finger_a_2 ─ tip_a
                                                                   ├─ finger_b_1 ─ tip_b
                                                                   ├─ finger_c_1 ─ tip_c
                                                                   └─ finger_d_1 ─ tip_d

     10 revolute joints: body 5 (waist 1 + two arms of 2), hand 5 (serial
     fingers, no loop closure). It is the smallest shape that has what a
     humanoid upper body with one hand has: a primary group with two branches
     and no single tip, and a secondary tree hanging off one of them.

     EVERY ASYMMETRY BELOW IS LOAD-BEARING. A test written against a model that
     lacks one passes while proving nothing about the thing it guards:
       - world → pelvis is a rotated, offset fixed joint, so a pose expressed in
         the tree root and the same pose in the world cannot be confused;
       - the two arms differ in link lengths, joint origins AND elbow axis, so
         feeding one arm's joint values into the other's joints moves the end
         somewhere else (a mirror-symmetric pair would hide that for symmetric
         poses);
       - hand_mount is NOT the identity (offset + two quarter turns), so the
         link before the mount (right_wrist) and the link the hand is built on
         (hand_base) are different frames;
       - the fingers differ in origin, axis and length, and each tip sits off
         its last joint axis, so a fingertip's position depends on that
         finger's own joint value and on no other's;
       - pinocchio orders the joints waist, left arm, right arm, then fingers
         a..d. A device may list them in any other order.
-->
<robot name="dual_arm_tree_hand">

  <link name="world"/>
  <joint name="world_to_pelvis" type="fixed">
    <parent link="world"/><child link="pelvis"/>
    <origin xyz="0.10 -0.20 0.80" rpy="0.10 -0.20 0.30"/>
  </joint>

  <!-- ── Body ─────────────────────────────────────────────────────────── -->
  <link name="pelvis">
    <inertial><mass value="5.0"/><origin xyz="0 0 0.02"/><inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/></inertial>
  </link>
  <link name="torso">
    <inertial><mass value="8.0"/><origin xyz="0 0 0.15"/><inertia ixx="0.08" ixy="0" ixz="0" iyy="0.07" iyz="0" izz="0.05"/></inertial>
  </link>
  <joint name="waist_yaw" type="revolute">
    <parent link="pelvis"/><child link="torso"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.0" upper="2.0" effort="80" velocity="10"/>
  </joint>

  <!-- left arm: both axes y, upper link 0.22 -->
  <link name="left_upper">
    <inertial><mass value="1.2"/><origin xyz="0 0 -0.10"/><inertia ixx="0.006" ixy="0" ixz="0" iyy="0.006" iyz="0" izz="0.002"/></inertial>
  </link>
  <link name="left_forearm">
    <inertial><mass value="0.8"/><origin xyz="0 0 -0.09"/><inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.001"/></inertial>
  </link>
  <link name="left_tip">
    <inertial><mass value="0.2"/><origin xyz="0 0 0"/><inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/></inertial>
  </link>
  <joint name="left_shoulder" type="revolute">
    <parent link="torso"/><child link="left_upper"/>
    <origin xyz="0.02 0.18 0.25" rpy="0.30 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.5" upper="2.5" effort="25" velocity="10"/>
  </joint>
  <joint name="left_elbow" type="revolute">
    <parent link="left_upper"/><child link="left_forearm"/>
    <origin xyz="0.03 0.02 -0.22" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="25" velocity="10"/>
  </joint>
  <joint name="left_tip_fixed" type="fixed">
    <parent link="left_forearm"/><child link="left_tip"/>
    <origin xyz="0.01 0 -0.19" rpy="0 0 0"/>
  </joint>

  <!-- right arm: shoulder axis y, elbow axis x, upper link 0.27 -->
  <link name="right_upper">
    <inertial><mass value="1.3"/><origin xyz="0 0 -0.12"/><inertia ixx="0.007" ixy="0" ixz="0" iyy="0.007" iyz="0" izz="0.002"/></inertial>
  </link>
  <link name="right_forearm">
    <inertial><mass value="0.9"/><origin xyz="0 0 -0.10"/><inertia ixx="0.004" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.001"/></inertial>
  </link>
  <link name="right_wrist">
    <inertial><mass value="0.2"/><origin xyz="0 0 0"/><inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/></inertial>
  </link>
  <joint name="right_shoulder" type="revolute">
    <parent link="torso"/><child link="right_upper"/>
    <origin xyz="0.01 -0.20 0.24" rpy="-0.20 0.10 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.5" upper="2.5" effort="25" velocity="10"/>
  </joint>
  <joint name="right_elbow" type="revolute">
    <parent link="right_upper"/><child link="right_forearm"/>
    <origin xyz="0.05 -0.01 -0.27" rpy="0 0 0.40"/>
    <axis xyz="1 0 0"/>
    <limit lower="-2.0" upper="2.0" effort="25" velocity="10"/>
  </joint>
  <joint name="right_wrist_fixed" type="fixed">
    <parent link="right_forearm"/><child link="right_wrist"/>
    <origin xyz="0.02 0 -0.21" rpy="0 0 0"/>
  </joint>

  <!-- ── Hand mount: NOT the identity ─────────────────────────────────── -->
  <link name="hand_base">
    <inertial><mass value="0.3"/><origin xyz="0 0 0.02"/><inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003"/></inertial>
  </link>
  <joint name="hand_mount" type="fixed">
    <parent link="right_wrist"/><child link="hand_base"/>
    <origin xyz="0.0415 -0.003 0.012" rpy="1.5708 0 1.5708"/>
  </joint>

  <!-- ── Fingers ──────────────────────────────────────────────────────── -->
  <!-- a: two joints -->
  <link name="a_proximal">
    <inertial><mass value="0.04"/><origin xyz="0 0 0.02"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial>
  </link>
  <link name="a_distal">
    <inertial><mass value="0.03"/><origin xyz="0 0 0.015"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial>
  </link>
  <link name="tip_a">
    <inertial><mass value="0.01"/><origin xyz="0 0 0"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
  </link>
  <joint name="finger_a_1" type="revolute">
    <parent link="hand_base"/><child link="a_proximal"/>
    <origin xyz="-0.02 0.03 0.05" rpy="0 0.50 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.0" upper="1.5" effort="3" velocity="5"/>
  </joint>
  <joint name="finger_a_2" type="revolute">
    <parent link="a_proximal"/><child link="a_distal"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.5" upper="1.5" effort="3" velocity="5"/>
  </joint>
  <joint name="tip_a_fixed" type="fixed">
    <parent link="a_distal"/><child link="tip_a"/>
    <origin xyz="0.004 0 0.030" rpy="0 0 0"/>
  </joint>

  <!-- b: one joint, axis y -->
  <link name="b_proximal">
    <inertial><mass value="0.03"/><origin xyz="0 0 0.02"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial>
  </link>
  <link name="tip_b">
    <inertial><mass value="0.01"/><origin xyz="0 0 0"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
  </link>
  <joint name="finger_b_1" type="revolute">
    <parent link="hand_base"/><child link="b_proximal"/>
    <origin xyz="0.03 0.01 0.07" rpy="0.20 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5" upper="1.5" effort="3" velocity="5"/>
  </joint>
  <joint name="tip_b_fixed" type="fixed">
    <parent link="b_proximal"/><child link="tip_b"/>
    <origin xyz="0 0.002 0.045" rpy="0 0 0"/>
  </joint>

  <!-- c: one joint, axis y, different length -->
  <link name="c_proximal">
    <inertial><mass value="0.03"/><origin xyz="0 0 0.02"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial>
  </link>
  <link name="tip_c">
    <inertial><mass value="0.01"/><origin xyz="0 0 0"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
  </link>
  <joint name="finger_c_1" type="revolute">
    <parent link="hand_base"/><child link="c_proximal"/>
    <origin xyz="0.03 -0.01 0.07" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5" upper="1.5" effort="3" velocity="5"/>
  </joint>
  <joint name="tip_c_fixed" type="fixed">
    <parent link="c_proximal"/><child link="tip_c"/>
    <origin xyz="0 0 0.052" rpy="0 0 0"/>
  </joint>

  <!-- d: one joint, axis x -->
  <link name="d_proximal">
    <inertial><mass value="0.03"/><origin xyz="0 0 0.02"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial>
  </link>
  <link name="tip_d">
    <inertial><mass value="0.01"/><origin xyz="0 0 0"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
  </link>
  <joint name="finger_d_1" type="revolute">
    <parent link="hand_base"/><child link="d_proximal"/>
    <origin xyz="0.03 -0.03 0.06" rpy="-0.20 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.5" upper="1.5" effort="3" velocity="5"/>
  </joint>
  <joint name="tip_d_fixed" type="fixed">
    <parent link="d_proximal"/><child link="tip_d"/>
    <origin xyz="0 -0.003 0.038" rpy="0 0 0"/>
  </joint>

</robot>
