<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rtc_tools</name>
  <version>5.18.0</version>
  <description>Python development utilities for the RTC framework: log plotter (plot_rtc_log), controller GUI, MJCF/URDF comparison tool, and URDF-to-MJCF converter.</description>
  <maintainer email="jeryblueput@gmail.com">Junho Park</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>rtc_msgs</exec_depend>
  <!-- /sim/reset_ball in the D-3 trial runner (analysis/clock_phase_trials.py). -->
  <exec_depend>std_srvs</exec_depend>
  <!-- S3.4 prediction-lane probe / camera relay (analysis/vision_lane_probe.py,
       camera_relay.py): PointStamped camera lane, Odometry truth, the
       estimator's DiagnosticArray. -->
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <!-- numpy / pandas / matplotlib / scipy / PyQt5 / mujoco: venv 책임 (requirements.lock).
       jazzy rosdep DB 미정의 + cross-workspace isolation 정책 (2026-05-23). -->
  <exec_depend>ament_index_python</exec_depend>
  <!-- derive_accel_limits (dynamic_catching S2.5): Pinocchio python bindings for
       M/g/c, xacro to expand the robot URDF. MuJoCo (optional cross-check) is a
       venv dependency like the other tools. -->
  <exec_depend>pinocchio</exec_depend>
  <exec_depend>xacro</exec_depend>
  <!-- catchability_map (dynamic_catching S3.5a) shells out to the C++ judge
       `catch_pose_ik_batch`, found under this package's ament prefix at runtime.
       A runtime edge only: rtc_controllers does not depend on rtc_tools, so
       there is no cycle (ARCH-2). The verdict must come from the same
       CatchPoseIk::Solve the runtime planner calls (plan §11 / S1.9), so it
       cannot be reimplemented here. -->
  <exec_depend>rtc_controllers</exec_depend>

  <!-- test_real_model_pairs.py 가 robot_descriptions 의 실제 MJCF/URDF 쌍에
       compare_mjcf_urdf 를 발사한다 (#392 재발 방지 게이트). 데이터 전용
       패키지이므로 <depend> 가 아니라 test 축으로만 건다 (ARCH-5). -->
  <test_depend>robot_descriptions</test_depend>
  <test_depend>python3-yaml</test_depend>
  <!-- 조합 모델(ur5e_assm_v1, iiwa7_leap, assm_v1)의 URDF 는 *.urdf.xacro 라
       게이트가 테스트 시점에 확장한다 (#414). -->
  <test_depend>xacro</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
