<mujoco model="imu_noise_test">
  <!-- IMU export noise fixture: the contact_minimal pendulum plus a gyro and
       an accelerometer (with an MJCF noise= that MuJoCo does not apply)
       and two frame sensors on the same site, so one export carries the
       noised IMU channels next to entries that must stay raw. -->
  <compiler angle="radian"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <worldbody>
    <body name="arm_base" pos="0 0 0.50">
      <joint name="j1" type="hinge" axis="0 1 0" range="-3.14 3.14" damping="0.5"/>
      <inertial pos="0 0 -0.20" mass="0.5" diaginertia="0.005 0.005 0.005"/>
      <geom type="capsule" fromto="0 0 0 0 0 -0.40" size="0.01"
            rgba="0.6 0.6 0.6 1" contype="0" conaffinity="0"/>
      <site name="imu_site" pos="0 0 -0.20" size="0.005"/>
      <body name="tip_link" pos="0 0 -0.45">
        <inertial pos="0 0 0" mass="0.05" diaginertia="0.0001 0.0001 0.0001"/>
        <geom name="tip_a_contact_geom" type="sphere" size="0.03"
              rgba="0.8 0.2 0.2 1"/>
        <site name="tip_a_ft_site" pos="0 0 0" size="0.003" group="3"/>
      </body>
    </body>

    <body name="ground">
      <geom name="ground_box" type="box" size="2 2 0.05" pos="0 0 0"/>
    </body>
  </worldbody>

  <actuator>
    <position name="m1" joint="j1" kp="50" kv="5" ctrlrange="-3.14 3.14"/>
  </actuator>

  <sensor>
    <!-- noise= here too: a non-IMU sensor imu_noise does not cover. -->
    <framepos name="imu_pos" objtype="site" objname="imu_site" noise="1e-3"/>
    <gyro name="imu_gyro" site="imu_site" noise="5e-4"/>
    <accelerometer name="imu_accel" site="imu_site" noise="1e-2"/>
    <framequat name="imu_quat" objtype="site" objname="imu_site"/>
    <contact name="tip_a_contact"
             geom1="tip_a_contact_geom"
             num="1"
             data="found force torque dist pos normal tangent"
             reduce="netforce"/>
  </sensor>
</mujoco>
