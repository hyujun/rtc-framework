<!-- ball_scene.xml with a pad that outranks the ball (priority 200). The ball's
     restitution would not apply to that pad, so Initialize must refuse the scene. -->
<mujoco model="ball_scene_high_priority_test">
  <compiler angle="radian"/>
  <option timestep="0.002" integrator="implicitfast" cone="elliptic" solver="Newton" iterations="20"/>

  <worldbody>
    <geom name="floor" type="plane" size="5 5 0.1" pos="0 0 0"/>
    <geom name="pad" type="box" size="0.1 0.1 0.01" pos="2 2 0.29" contype="1" conaffinity="2"
          solref="0.02 1" priority="200" friction="1.2 0.005 0.0001"/>

    <!-- Raised clear of the floor. A cylinder buried in the plane is a permanent
         deep contact; with island discovery off (solver_param.yaml default) it
         shares the solve with the ball and kicks it (measured: 20 mm hops, a
         rolling ball that never stops). -->
    <body name="link1" pos="0 0 0.11">
      <joint name="j1" type="hinge" axis="0 0 1" range="-3.14 3.14"/>
      <inertial pos="0 0 0.1" mass="1.0" diaginertia="0.01 0.01 0.01"/>
      <geom type="cylinder" size="0.05 0.1"/>
      <body name="link2" pos="0 0 0.2">
        <joint name="j2" type="hinge" axis="0 1 0" range="-1.57 1.57"/>
        <inertial pos="0 0 0.1" mass="0.5" diaginertia="0.005 0.005 0.005"/>
        <geom type="capsule" size="0.03 0.1"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="m1" joint="j1" kp="100" ctrlrange="-3.14 3.14"/>
    <position name="m2" joint="j2" kp="100" ctrlrange="-1.57 1.57"/>
  </actuator>
</mujoco>
