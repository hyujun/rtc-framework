<mujoco model="motor_arm_test">
  <!-- Two hinge joints driven by TORQUE MOTORS (`<motor>`), which is how a
       robot MJCF written for torque control ships — and what minimal.xml, with
       its `<position>` actuators, cannot stand in for: a `<motor>` compiles to
       biastype none, so a position-servo lane that only rewrites gainprm /
       biasprm leaves it a motor.

       Both axes are horizontal and both links hang off-axis, so gravity loads
       both joints. The servo lane switches per-body gravcomp on for the robot;
       a test that reads a held pose is therefore also reading that the mode
       switch ran. No joint range: a runaway joint must show up as a wrong
       position, not be caught by a limit and look "held". -->
  <compiler angle="radian"/>
  <option timestep="0.002" solver="Newton" iterations="20"/>

  <worldbody>
    <body name="link1" pos="0 0 0.5">
      <joint name="j1" type="hinge" axis="0 1 0"/>
      <inertial pos="0.1 0 0" mass="1.0" diaginertia="0.01 0.01 0.01"/>
      <geom type="capsule" fromto="0 0 0 0.2 0 0" size="0.03" rgba="0.8 0.2 0.2 1"/>

      <body name="link2" pos="0.2 0 0">
        <joint name="j2" type="hinge" axis="0 1 0"/>
        <inertial pos="0.1 0 0" mass="0.5" diaginertia="0.005 0.005 0.005"/>
        <geom type="capsule" fromto="0 0 0 0.2 0 0" size="0.025" rgba="0.2 0.8 0.2 1"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="m1" joint="j1"/>
    <motor name="m2" joint="j2"/>
  </actuator>
</mujoco>
