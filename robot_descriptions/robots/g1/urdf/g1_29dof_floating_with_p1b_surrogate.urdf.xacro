<?xml version="1.0"?>
<!--
  Unitree G1 29-DoF floating-base body (wrists rigid, 23 actuated) + p1b_surrogate
  on the right wrist — a TEST model: the hand is the synthetic one of
  ../../p1b_surrogate/README.md, not a real hand.

  The body is urdf/g1_29dof_floating.urdf unchanged (root = pelvis; the floating
  joint, if any, is the loader's — rtc_urdf_bridge urdf.root_joint_type). The hand
  mount (right_wrist_yaw_link → base_adapter) is the one
  integrated_bringup/config/g1_loco/_base.yaml states, the same transform as
  g1_with_p1b_surrogate_fixed_base.urdf.xacro. Paired with
  g1_29dof_floating_with_p1b_surrogate.closure.yaml.

  Process with: xacro g1_29dof_floating_with_p1b_surrogate.urdf.xacro
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="g1_29dof_floating_with_p1b_surrogate">
  <xacro:include filename="$(find robot_descriptions)/robots/g1/urdf/g1_29dof_floating.urdf"/>
  <xacro:include filename="$(find robot_descriptions)/robots/p1b_surrogate/urdf/p1b_surrogate.urdf.xacro"/>

  <joint name="right_wrist_to_p1b_surrogate" type="fixed">
    <parent link="right_wrist_yaw_link"/>
    <child link="base_adapter"/>
    <origin xyz="0.0415 -0.003 0" rpy="1.5707963267948966 0 1.5707963267948966"/>
  </joint>
</robot>
