<?xml version="1.0"?>
<!--
  UR5e + p1b_surrogate (synthetic test hand, see ../README.md), the hand's
  base_adapter on the flange (tool0). Paired with
  ur5e_with_p1b_surrogate.closure.yaml.

  Process with: xacro ur5e_with_p1b_surrogate.urdf.xacro
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ur5e_with_p1b_surrogate">
  <xacro:include filename="$(find robot_descriptions)/robots/ur5e/urdf/ur5e.urdf"/>
  <xacro:include filename="$(find robot_descriptions)/robots/p1b_surrogate/urdf/p1b_surrogate.urdf.xacro"/>

  <joint name="tool0_to_p1b_surrogate" type="fixed">
    <parent link="tool0"/>
    <child link="base_adapter"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
</robot>
