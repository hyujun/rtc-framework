<?xml version='1.0' encoding='utf-8'?>
<mujoco model="iiwa7">
  <compiler angle="radian" meshdir="../meshes" autolimits="true" />
  <!-- timestep/iterations/ls_iterations 등 solver 파라미터는 mujoco_simulator.yaml에서
       관리한다 (rtc_mujoco_sim ApplySolverConfig가 scene_*.xml에서만 <option>을 탐지하므로
       자식 모델의 <option>은 어차피 YAML로 덮어씌워짐). -->
  <option integrator="implicitfast" />

  <!-- ─── default classes (joint properties + position-servo PD SSoT) ─────────
       Panda 유사 class. proximal(J1-J4)이 큰 link 관성/토크 → 상향.
       PD gain은 ur5e MJCF 패턴(size3 kp=2000/kd=400, size1 kp=500/kd=100, ζ≈0.2)을
       따르되 iiwa7 payload에 맞춰 1.5× 스케일:
         proximal kp=3000 kd=600, distal kp=750 kd=150.
       합체 모델 (iiwa7_leap/mjcf/iiwa7_with_leap_*.xml)과 값 동기화 유지. -->
  <default>
    <!-- Baseline: any <geom> that doesn't explicitly set `group` lands in
         group=3 (the "collision" bucket used across the repo, see ur5e MJCF).
         Visual meshes below explicitly set `group="1"` so they override this
         baseline. In the MuJoCo viewer, press '3' to toggle collision geoms
         on/off — they're rendered by default (mjvOption.geomgroup[3]=1) but
         can be hidden without affecting the visual mesh layer. -->
    <geom group="3" />
    <default class="iiwa7">
      <joint armature="0.2" damping="2.0" frictionloss="0.3" />
      <general gaintype="fixed" biastype="affine" forcerange="-200 200" />
      <default class="iiwa7_proximal">
        <joint armature="0.25" damping="3.0" frictionloss="0.5" />
        <general gainprm="3000" biasprm="0 -3000 -600" />
      </default>
      <default class="iiwa7_distal">
        <joint armature="0.15" damping="1.0" frictionloss="0.2" />
        <general gainprm="750" biasprm="0 -750 -150" />
      </default>
    </default>
  </default>

  <!-- Mesh assets: visual (high-poly) + collision (simplified convex) split.
       URDF (robots/iiwa7/urdf/iiwa7.urdf) is the SSoT for the meshes/visual vs
       meshes/collision file layout; this MJCF mirrors it. <inertial> is given
       on every body, so geom-derived mass/inertia is ignored — changing the
       collision mesh affects contact geometry only.

       Material note: MuJoCo's native OBJ loader ignores `mtllib`/`usemtl`, so
       the per-submesh colors and "KUKA" lettering baked into the .mtl files
       are lost on load (nmat=0). We apply a single `iiwa_silver` material to
       every visual geom — Kd from the dominant Opaque(153,153,153) entry —
       to recover the silver body tone. Full per-material recovery would
       require splitting each link OBJ by usemtl group (ur5e MJCF pattern). -->
  <asset>
    <material name="iiwa_silver" rgba="0.83 0.85 0.90 1" specular="0.4" shininess="0.3" />
    <mesh name="link_0_vis" content_type="model/obj" file="visual/link_0.obj" />
    <mesh name="link_1_vis" content_type="model/obj" file="visual/link_1.obj" />
    <mesh name="link_2_vis" content_type="model/obj" file="visual/link_2.obj" />
    <mesh name="link_3_vis" content_type="model/obj" file="visual/link_3.obj" />
    <mesh name="link_4_vis" content_type="model/obj" file="visual/link_4.obj" />
    <mesh name="link_5_vis" content_type="model/obj" file="visual/link_5.obj" />
    <mesh name="link_6_vis" content_type="model/obj" file="visual/link_6.obj" />
    <mesh name="link_7_vis" content_type="model/obj" file="visual/link_7.obj" />
    <mesh name="link_0_col" content_type="model/obj" file="collision/link_0.obj" />
    <mesh name="link_1_col" content_type="model/obj" file="collision/link_1.obj" />
    <mesh name="link_2_col" content_type="model/obj" file="collision/link_2.obj" />
    <mesh name="link_3_col" content_type="model/obj" file="collision/link_3.obj" />
    <mesh name="link_4_col" content_type="model/obj" file="collision/link_4.obj" />
    <mesh name="link_5_col" content_type="model/obj" file="collision/link_5.obj" />
    <mesh name="link_6_col" content_type="model/obj" file="collision/link_6.obj" />
    <mesh name="link_7_col" content_type="model/obj" file="collision/link_7.obj" />
  </asset>
  <worldbody>
    <body name="link_0">
      <inertial pos="-0.012857 0 0.069964" quat="0.444802 0.549682 0.549682 0.444802" mass="4.85566" diaginertia="0.022294 0.0215006 0.0176724" />
      <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" mesh="link_0_vis" material="iiwa_silver" />
      <geom type="mesh" mesh="link_0_col" />
      <body name="link_1" pos="0 0 0.1475">
        <inertial pos="0 -0.034819 0.123299" quat="0.700813 0.0941355 -0.0941355 0.700813" mass="3.39401" diaginertia="0.0214418 0.021383 0.00652421" />
        <joint name="A1" class="iiwa7_proximal" pos="0 0 0" axis="0 0 1" range="-2.96706 2.96706" actuatorfrcrange="-200 200" />
        <geom pos="0 0 -0.1475" type="mesh" contype="0" conaffinity="0" group="1" density="0" mesh="link_1_vis" material="iiwa_silver" />
        <geom pos="0 0 -0.1475" type="mesh" mesh="link_1_col" />
        <body name="link_2" pos="0 -0.0105 0.1925">
          <inertial pos="0 0.039793 0.086944" quat="0.991454 0.130453 0 0" mass="4.03199" diaginertia="0.031697 0.031657 0.00808898" />
          <joint name="A2" class="iiwa7_proximal" pos="0 0 0" axis="0 1 0" range="-2.0944 2.0944" actuatorfrcrange="-200 200" />
          <geom pos="0 0.0105 -0.34" type="mesh" contype="0" conaffinity="0" group="1" density="0" mesh="link_2_vis" material="iiwa_silver" />
          <geom pos="0 0.0105 -0.34" type="mesh" mesh="link_2_col" />
          <body name="link_3" pos="0 0.0105 0.2075">
            <inertial pos="0 0.034819 0.123299" quat="0.700813 -0.0941355 0.0941355 0.700813" mass="3.39401" diaginertia="0.0214418 0.021383 0.00652421" />
            <joint name="A3" class="iiwa7_proximal" pos="0 0 0" axis="0 0 1" range="-2.96706 2.96706" actuatorfrcrange="-200 200" />
            <geom pos="0 0 -0.5475" type="mesh" contype="0" conaffinity="0" group="1" density="0" mesh="link_3_vis" material="iiwa_silver" />
            <geom pos="0 0 -0.5475" type="mesh" mesh="link_3_col" />
            <body name="link_4" pos="0 0.0105 0.1925">
              <inertial pos="0 -0.039793 0.086944" quat="0.991454 -0.130453 0 0" mass="4.03199" diaginertia="0.031695 0.031656 0.00808798" />
              <joint name="A4" class="iiwa7_proximal" pos="0 0 0" axis="0 -1 0" range="-2.0944 2.0944" actuatorfrcrange="-200 200" />
              <geom pos="0 -0.0105 -0.74" type="mesh" contype="0" conaffinity="0" group="1" density="0" mesh="link_4_vis" material="iiwa_silver" />
              <geom pos="0 -0.0105 -0.74" type="mesh" mesh="link_4_col" />
              <body name="link_5" pos="0 -0.0105 0.2075">
                <inertial pos="0 -0.029824 0.076267" quat="0.683304 0.181923 -0.181923 0.683304" mass="1.52924" diaginertia="0.00874413 0.008485 0.00223987" />
                <joint name="A5" class="iiwa7_distal" pos="0 0 0" axis="0 0 1" range="-2.96706 2.96706" actuatorfrcrange="-200 200" />
                <geom pos="0 0 -0.9475" quat="1 0 0 0" type="mesh" contype="0" conaffinity="0" group="1" density="0" mesh="link_5_vis" material="iiwa_silver" />
                <geom pos="0 0 -0.9475" quat="1 0 0 0" type="mesh" mesh="link_5_col" />
                <body name="link_6" pos="0 -0.0707 0.1925">
                  <inertial pos="0 0.07102 0.00495" quat="0.997576 0.0695794 0 0" mass="2.40363" diaginertia="0.007067 0.0068476 0.0045854" />
                  <joint name="A6" class="iiwa7_distal" pos="0 0 0" axis="0 1 0" range="-2.0944 2.0944" actuatorfrcrange="-200 200" />
                  <geom pos="0 0.0707 -1.14" type="mesh" contype="0" conaffinity="0" group="1" density="0" mesh="link_6_vis" material="iiwa_silver" />
                  <geom pos="0 0.0707 -1.14" type="mesh" mesh="link_6_col" />
                  <body name="link_7" pos="0 0.0707 0.091">
                    <inertial pos="3e-06 -2e-06 0.013782" quat="0.5 0.5 -0.5 0.5" mass="0.259474" diaginertia="0.000299 0.000171 0.000171" />
                    <joint name="A7" class="iiwa7_distal" pos="0 0 0" axis="0 0 1" range="-3.05433 3.05433" actuatorfrcrange="-200 200" />
                    <geom pos="0 0 -1.231" quat="1 0 0 0" type="mesh" contype="0" conaffinity="0" group="1" density="0" mesh="link_7_vis" material="iiwa_silver" />
                    <geom pos="0 0 -1.231" quat="1 0 0 0" type="mesh" mesh="link_7_col" />
                    <body name="ee_link" pos="0 0 0.035" quat="0.707109 0 -0.707105 0" />
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
  <actuator>
    <general class="iiwa7_proximal" name="A1" joint="A1" ctrlrange="-2.9671 2.9671" />
    <general class="iiwa7_proximal" name="A2" joint="A2" ctrlrange="-2.0944 2.0944" />
    <general class="iiwa7_proximal" name="A3" joint="A3" ctrlrange="-2.9671 2.9671" />
    <general class="iiwa7_proximal" name="A4" joint="A4" ctrlrange="-2.0944 2.0944" />
    <general class="iiwa7_distal"   name="A5" joint="A5" ctrlrange="-2.9671 2.9671" />
    <general class="iiwa7_distal"   name="A6" joint="A6" ctrlrange="-2.0944 2.0944" />
    <general class="iiwa7_distal"   name="A7" joint="A7" ctrlrange="-3.0543 3.0543" />
  </actuator>
  <!-- Parent-child contact excludes for iiwa7 arm chain (re-enabled 2026-05-24).
       collision/*.obj convex hulls overlap by 10~52 mm at every joint axis
       (geometric query at qpos=0; same overlap existed with visual mesh too).
       filterparent only filters weld-attached pairs — revolute joints make
       link_N ↔ link_N+1 NOT weld-attached, so explicit exclude is required.
       Without these excludes, mj_step generates steady-state contacts at the
       deepest pair (link_5↔link_6 −52 mm) and causes shoulder trembling.
       Originally removed 2026-05-15; re-enabled after the visual/collision
       mesh split surfaced the long-standing overlap as a reliable contact. -->
  <contact>
    <exclude body1="link_0" body2="link_1" />
    <exclude body1="link_1" body2="link_2" />
    <exclude body1="link_2" body2="link_3" />
    <exclude body1="link_3" body2="link_4" />
    <exclude body1="link_4" body2="link_5" />
    <exclude body1="link_5" body2="link_6" />
    <exclude body1="link_6" body2="link_7" />
  </contact>
</mujoco>
