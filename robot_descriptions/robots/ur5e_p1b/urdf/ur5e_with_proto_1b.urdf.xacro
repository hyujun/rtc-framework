<?xml version="1.0"?>
<!--
  Combined URDF: UR5e + proto_1b hand (closed-chain test fixture, #457).

  proto_1b `base_adapter` is attached to UR5e `tool0` via a fixed joint, exactly
  as the upstream hand_description model does. Paired with
  ur5e_with_proto_1b.closure.yaml this is the only in-repo model whose
  `GetActuatedModel()` is non-null with more than one independent DoF, which is
  what the closed-chain projection / reduced-dynamics tests need (see README.md).

  Process with: xacro ur5e_with_proto_1b.urdf.xacro
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ur5e_with_proto_1b">

  <!-- UR5e base robot (pre-generated URDF, included as-is).
       This is the repo's canonical ur5e.urdf — kinematics and inertias are
       byte-identical to the hand_description copy this fixture came from; the
       only upstream difference was the mesh `package://` prefix. -->
  <xacro:include filename="$(find robot_descriptions)/robots/ur5e/urdf/ur5e.urdf"/>

  <!-- proto_1b hand model (vendored, kinematics-only — no meshes) -->
  <xacro:include filename="$(find robot_descriptions)/robots/ur5e_p1b/urdf/proto_1b.urdf"/>

  <!-- Attach proto_1b to tool0 -->
  <joint name="tool0_to_proto_1b" type="fixed">
    <parent link="tool0"/>
    <child link="base_adapter"/>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
  </joint>

</robot>
