<mujoco model="iiwa7_with_leap_right scene">
  <include file="iiwa7_with_leap_right.xml"/>

  <statistic center="0.3 0 0.4" extent="0.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
      rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <!-- group="2": the robot MJCF's main default is group="3" (collision bucket),
         which MuJoCo's mjv_defaultOption hides by default (only groups 0/1/2 are
         shown). Scene/world geoms must opt into a visible group explicitly. -->
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" group="2"/>
  </worldbody>
</mujoco>
