CompileFlags:
  CompilationDatabase: .
  Add:
    - "-std=c++20"
    - "-Wall"
    - "-Wextra"
    - "-Wpedantic"
    - "-Wshadow"
    - "-Wconversion"
    - "-Wsign-conversion"
    # NOTE: omp.h (pinocchio/proxsuite include it) must come from LLVM's own
    # resource-dir, installed by `libomp-dev` — never from GCC's compiler-
    # internal include dir. Adding GCC's dir puts its xmmintrin.h/mmintrin.h
    # ahead of clang's and breaks _mm_prefetch (issue #193).

Index:
  Background: Build

InlayHints:
  Enabled: Yes
  ParameterNames: Yes
  DeducedTypes: Yes

Hover:
  ShowAKA: Yes
